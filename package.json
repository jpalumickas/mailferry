{
  "name": "mailferry",
  "version": "0.1.1",
  "type": "module",
  "exports": {
    "./providers/mailgun": {
      "types": "./dist/providers/mailgun/index.d.ts",
      "require": "./dist/providers/mailgun/index.cjs",
      "default": "./dist/providers/mailgun/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "@react-email/render": "^1.0.5",
    "hono": "^4.7.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "@types/react": "^19.0.10",
    "react": "^19.0.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": ">= 18.3.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "clean": "rimraf dist",
    "clean:full": "rimraf .turbo node_modules dist"
  },
  "packageManager": "pnpm@10.5.2+sha512.da9dc28cd3ff40d0592188235ab25d3202add8a207afbedc682220e4a0029ffbff4562102b9e6e46b4e3f9e8bd53e6d05de48544b0c57d4b0179e22c76d1199b"
}
