{
  "name": "mailferry",
  "version": "0.1.6",
  "type": "module",
  "exports": {
    "./providers/mailgun": {
      "types": "./dist/providers/mailgun/index.d.ts",
      "require": "./dist/providers/mailgun/index.cjs",
      "default": "./dist/providers/mailgun/index.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "@react-email/render": "^1.0.5",
    "hono": "^4.13.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "^19.2.18",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">= 18.3.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "clean": "rimraf dist",
    "clean:full": "rimraf .turbo node_modules dist"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
