{
  "name": "mailferry",
  "version": "0.7.0",
  "description": "Render and send localized React email templates with a Fetch API handler",
  "keywords": [
    "email",
    "react",
    "react-email",
    "fetch-api",
    "hono",
    "cloudflare-workers",
    "mailgun",
    "cloudflare-email"
  ],
  "license": "MIT",
  "type": "module",
  "repository": "https://github.com/jpalumickas/mailferry",
  "homepage": "https://github.com/jpalumickas/mailferry#readme",
  "bugs": "https://github.com/jpalumickas/mailferry/issues",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./client": {
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      },
      "default": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      }
    },
    "./server": {
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      },
      "default": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      }
    },
    "./providers/cloudflare": {
      "require": {
        "types": "./dist/providers/cloudflare/index.d.cts",
        "default": "./dist/providers/cloudflare/index.cjs"
      },
      "default": {
        "types": "./dist/providers/cloudflare/index.d.mts",
        "default": "./dist/providers/cloudflare/index.mjs"
      }
    },
    "./providers/mailgun": {
      "require": {
        "types": "./dist/providers/mailgun/index.d.cts",
        "default": "./dist/providers/mailgun/index.cjs"
      },
      "default": {
        "types": "./dist/providers/mailgun/index.d.mts",
        "default": "./dist/providers/mailgun/index.mjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "hono": "^4.13.8",
    "i18next": "^26.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
