{
  "name": "mailferry",
  "version": "0.1.6",
  "type": "module",
  "exports": {
    "./providers/mailgun": {
      "require": {
        "types": "./dist/providers/mailgun/index.d.cts",
        "default": "./dist/providers/mailgun/index.cjs"
      },
      "default": {
        "types": "./dist/providers/mailgun/index.d.mts",
        "default": "./dist/providers/mailgun/index.mjs"
      }
    },
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "@react-email/render": "^1.0.5",
    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">= 18.3.1"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
