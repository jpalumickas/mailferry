{
  "name": "mailferry",
  "version": "0.6.0",
  "type": "module",
  "repository": "https://github.com/jpalumickas/mailferry",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    "./client": {
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      },
      "default": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      }
    },
    "./server": {
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      },
      "default": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      }
    },
    "./providers/mailgun": {
      "require": {
        "types": "./dist/providers/mailgun/index.d.cts",
        "default": "./dist/providers/mailgun/index.cjs"
      },
      "default": {
        "types": "./dist/providers/mailgun/index.d.mts",
        "default": "./dist/providers/mailgun/index.mjs"
      }
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": false,
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-email": "^6.9.5",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">= 18.3.1"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "npm run build",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:dev": "vitest dev",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
